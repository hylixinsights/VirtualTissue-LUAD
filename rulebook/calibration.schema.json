{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csbl/luad-virtual-tissue/rulebook/calibration.schema.json",
  "title": "LUAD3 signature calibration",
  "description": "Reference distributions fitted on the whole section, which the engine uses to turn a raw UCell value into a percentile and a depth residual. Generated by scripts/build_calibration.py; not hand-edited.",
  "type": "object",
  "required": [
    "calibration_version",
    "source",
    "fitted_on",
    "depth_covariate",
    "signatures",
    "cell_types"
  ],
  "additionalProperties": false,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "coverageFlag": {
      "type": "string",
      "enum": [
        "sufficient",
        "low_coverage",
        "identity_confounded",
        "direction_ambiguous"
      ]
    }
  },
  "properties": {
    "calibration_version": {
      "$ref": "#/$defs/semver"
    },
    "generated_utc": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "file",
        "annotation_column"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{64})?$"
        },
        "annotation_column": {
          "type": "string"
        }
      }
    },
    "fitted_on": {
      "type": "object",
      "required": [
        "population",
        "n_cells",
        "note"
      ],
      "properties": {
        "population": {
          "type": "string"
        },
        "n_cells": {
          "type": "integer",
          "minimum": 1000,
          "description": "A patch-sized population cannot estimate its own percentiles."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "depth_covariate": {
      "type": "object",
      "required": [
        "obs_column",
        "n_deciles",
        "caveat"
      ],
      "properties": {
        "obs_column": {
          "type": "string"
        },
        "matrix": {
          "type": "string"
        },
        "caveat": {
          "type": "string"
        },
        "n_deciles": {
          "type": "integer",
          "const": 10
        }
      }
    },
    "signatures": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^GOBP_"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "process",
          "go_id",
          "obs_column",
          "n_genes_geneset",
          "n_genes_on_panel",
          "panel_coverage",
          "coverage_flag",
          "n_genes_effective"
        ],
        "additionalProperties": false,
        "properties": {
          "process": {
            "type": "string"
          },
          "go_id": {
            "type": "string",
            "pattern": "^GO:\\d{7}$"
          },
          "obs_column": {
            "type": "string"
          },
          "n_genes_geneset": {
            "type": "integer",
            "minimum": 1
          },
          "n_genes_on_panel": {
            "type": "integer",
            "minimum": 1
          },
          "panel_coverage": {
            "$ref": "#/$defs/unitInterval"
          },
          "genes_on_panel": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverage_flag": {
            "$ref": "#/$defs/coverageFlag"
          },
          "n_genes_deleted_by_layer": {
            "type": "integer",
            "minimum": 0
          },
          "genes_deleted_by_layer": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "n_genes_effective": {
            "type": "integer",
            "minimum": 0
          },
          "effective_coverage": {
            "$ref": "#/$defs/unitInterval"
          }
        }
      }
    },
    "cell_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "n_scored",
          "depth_decile_edges",
          "signatures"
        ],
        "additionalProperties": false,
        "properties": {
          "n_scored": {
            "type": "integer",
            "minimum": 1
          },
          "median_n_genes_by_counts": {
            "type": "number"
          },
          "depth_decile_edges": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 11,
            "maxItems": 11
          },
          "signatures": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "percentile_edges",
                "percentile_grid",
                "zero_fraction",
                "median",
                "median_by_depth_decile",
                "rho_vs_depth_within_type",
                "coverage_flag",
                "admissible_use",
                "inadmissible_use"
              ],
              "additionalProperties": false,
              "properties": {
                "percentile_edges": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 11,
                  "maxItems": 11
                },
                "percentile_grid": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 11,
                  "maxItems": 11
                },
                "zero_fraction": {
                  "$ref": "#/$defs/unitInterval"
                },
                "median": {
                  "type": "number",
                  "minimum": 0
                },
                "median_by_depth_decile": {
                  "type": "array",
                  "minItems": 10,
                  "maxItems": 10,
                  "items": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "rho_vs_depth_within_type": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "coverage_flag": {
                  "$ref": "#/$defs/coverageFlag"
                },
                "admissible_use": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "inadmissible_use": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "contains": {
                    "const": "threshold_on_raw_value"
                  },
                  "description": "Engine constraint H13: a raw UCell value may never appear in a threshold."
                }
              }
            }
          }
        }
      }
    }
  }
}
